# Héphaïstos — variables d'environnement (HEP-32)
#
# Ce fichier est versionné et ne contient AUCUN secret : uniquement les clés
# attendues et leur forme. En local :
#
#   vercel env pull .env.local        # une fois le projet lié
#   bun run db:local:up               # ou une base jetable, sans compte Neon
#
# Règle absolue : jamais de préfixe NEXT_PUBLIC_ sur une clé serveur. Tout ce
# qui porte ce préfixe est inclus en clair dans le bundle envoyé au navigateur.

# --- Base de données (Neon) -------------------------------------------------
# Deux chaînes, et elles ne sont pas interchangeables :
#   DATABASE_URL : chaîne POOLÉE (l'hôte contient `-pooler`). Utilisée par
#                  l'application. Sans le pooler, chaque invocation de fonction
#                  ouvre une connexion et Neon sature.
#   DIRECT_URL   : chaîne DIRECTE. Utilisée par les migrations, qui ont besoin
#                  de verrous consultatifs et d'une shadow database — deux
#                  choses que le pooler ne sait pas faire.
# Les deux doivent exister dans les 3 environnements, sinon `prisma migrate
# deploy` échoue en CI.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/hephaistos?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/hephaistos?sslmode=require"

# --- Base jetable locale (bun run db:local:up) ------------------------------
# DATABASE_URL="postgresql://hep:hep@localhost:55432/hephaistos"
# DIRECT_URL="postgresql://hep:hep@localhost:55432/hephaistos"

# --- Application ------------------------------------------------------------
# Origine publique, utilisée pour les liens des emails, les canoniques SEO et
# les URLs de retour Stripe. Sans protocole ni slash final.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Sel de hachage des IP. Les IP brutes ne sont jamais stockées (RGPD) : elles
# sont hachées en SHA-256 avec ce sel avant d'entrer en base.
# Générer avec : openssl rand -base64 32
IP_HASH_SALT=""

# --- Administration (verrou provisoire, HEP-39) -----------------------------
# `/admin` n'a PAS encore d'authentification (Better Auth = HEP-62, garde et
# 2FA = HEP-78). Ce drapeau est le seul moyen d'y accéder, et il est ignoré
# hors développement. Ne jamais le définir en preview ni en production.
ADMIN_UNSAFE_LOCAL="0"

# --- Cache et rate limiting (Upstash Redis, HEP-35) -------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Authentification (Better Auth, HEP-62) ---------------------------------
# Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Paiement (Stripe, HEP-57) ----------------------------------------------
# Clés de TEST en development et preview, clés LIVE en production uniquement.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- Emails transactionnels (Resend, HEP-65) --------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="commandes@hephaistosparis.com"

# --- Marketing (Brevo, HEP-77) — synchronisation sortante uniquement --------
BREVO_API_KEY=""

# --- Livraison (Sendcloud, HEP-69) ------------------------------------------
SENDCLOUD_PUBLIC_KEY=""
SENDCLOUD_SECRET_KEY=""

# --- Fichiers (Vercel Blob, HEP-43) -----------------------------------------
BLOB_READ_WRITE_TOKEN=""

# --- Observabilité (Sentry, HEP-38) -----------------------------------------
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# --- Mesure d'audience (lot 12, HEP-91) -------------------------------------
# Chargés uniquement après consentement explicite. Le pixel Meta est public ;
# le token CAPI est un secret serveur et ne doit jamais porter NEXT_PUBLIC_.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
